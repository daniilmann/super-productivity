<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <!-- Prevent restored legacy launch_mode from pinning fresh installs to online mode. -->
    <exclude
      domain="sharedpref"
      path="com.superproductivity.superproductivity_preferences.xml" />
    <!-- Keystore-bound ciphertext; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivitySync.xml" />
    <!-- Per-device WebView verdict; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="webview_compatibility.xml" />
    <!-- Device-bound tracking session; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivityTracking.xml" />
    <!-- Install-bound launch URL stamp; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivityLaunchUrl.xml" />
    <!-- Fork: no app data goes to Google cloud backup (see FORK.md). -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <!-- A transferred fresh install should select launch mode from current state. -->
    <exclude
      domain="sharedpref"
      path="com.superproductivity.superproductivity_preferences.xml" />
    <!-- Keystore-bound ciphertext; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivitySync.xml" />
    <!-- Per-device WebView verdict; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="webview_compatibility.xml" />
    <!-- Device-bound tracking session; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivityTracking.xml" />
    <!-- Install-bound launch URL stamp; see backup_rules.xml. -->
    <exclude
      domain="sharedpref"
      path="SuperProductivityLaunchUrl.xml" />
  </device-transfer>
</data-extraction-rules>
